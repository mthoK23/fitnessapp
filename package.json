{
  "name": "fittrack",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "node server/dev.js",
    "dev": "node server/dev.js",
    "build": "vite build",
    "serve": "node server/index.js",
    "test": "vitest run",
    "test:server": "node --test server/server.test.js",
    "check": "npm test && npm run test:server && npm run build",
    "format": "prettier --write src server vite.config.js package.json index.html"
  },
  "dependencies": {
    "express": "^5.2.1",
    "lucide-react": "^0.468.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.9",
    "vite": "^7.0.0",
    "vitest": "^5.0.2"
  }
}
